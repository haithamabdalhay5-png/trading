# Server-only. Never commit actual values.
MT5_INGEST_TOKEN=replace-with-a-long-random-secret
GOOGLE_DRIVE_FILE_ID=1J4b5-FIEK63mwu1Jp5cS6f1cF5bcUuTy

# Supabase: public URL/anon key are browser-safe; service role remains server-only.
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Gemini: server-only; model must be verified against the active API key.
GEMINI_API_KEY=replace-with-server-only-gemini-api-key
GEMINI_MODEL=replace-with-a-model-verified-for-your-Gemini-project
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=1

# QStash: server-only signing and publishing credentials.
QSTASH_TOKEN=replace-with-qstash-token
QSTASH_CURRENT_SIGNING_KEY=replace-with-current-signing-key
QSTASH_NEXT_SIGNING_KEY=replace-with-next-signing-key

# Optional Redis operational locks/cooldowns. Never used for EA latest-snapshot ingestion.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Telegram report delivery: server-only and manual only.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# Public production URL.
APP_URL=https://your-app.vercel.app

# External heartbeat authentication.
MONITOR_HEARTBEAT_TOKEN=replace-with-a-long-random-secret

# Analysis limits.
MIRAS_DAILY_STANDARD_LIMIT=20
MIRAS_DAILY_DEEP_LIMIT=10
MIRAS_DAILY_QSTASH_RESERVED_LIMIT=800
